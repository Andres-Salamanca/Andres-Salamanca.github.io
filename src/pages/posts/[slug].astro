---
import { render } from 'astro:content';
import Desktop from '../../layouts/Desktop.astro';
import { SITE, formatDate, formatTags, readingTime } from '../../lib/site';
import { getPosts } from '../../lib/stats';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { title, date, updated, description, tags } = post.data;
const { Content } = await render(post);
const url = new URL(`/posts/${post.id}/`, Astro.site);
const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url,
  mainEntityOfPage: url,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: { '@type': 'Person', name: SITE.name, url: Astro.site },
  image: new URL('/og-default.png', Astro.site),
};
---
<Desktop
  title={`${title} | ${SITE.name}`}
  description={description}
  type="article"
  jsonLd={article}
  mainClass="post-main"
  tasks={[{ label: `${post.id}.md` }]}
>
  <article class="window post">
    <div class="titlebar">
      <span>~/posts/{post.id}.md</span>
      <a class="title-btn" href="/" aria-label="Close and go home">x</a>
    </div>
    <div class="meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span>{readingTime(post.body)} min read</span>
      <span class="tags">{formatTags(tags)}</span>
    </div>
    <div class="reading">
      <div class="prose">
        <h1>{title}</h1>
        <Content />
      </div>
    </div>
    <nav class="more" aria-label="More posts">
      {older && <a class="btn" href={`/posts/${older.id}/`}>&lt;- prev: {older.data.title}</a>}
      <a class="btn" href="/posts/">all posts</a>
      {newer && <a class="btn" href={`/posts/${newer.id}/`}>next: {newer.data.title} -&gt;</a>}
    </nav>
  </article>
</Desktop>
