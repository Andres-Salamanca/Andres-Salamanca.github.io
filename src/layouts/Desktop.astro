---
import '@fontsource/vt323/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-serif/latin-400.css';
import '@fontsource/ibm-plex-serif/latin-400-italic.css';
import '@fontsource/ibm-plex-serif/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '../styles/global.css';
import '../styles/prose.css';
import vt323 from '@fontsource/vt323/files/vt323-latin-400-normal.woff2?url';
import plexSans from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import DesktopIcons from '../components/DesktopIcons.astro';
import Seo from '../components/Seo.astro';
import Taskbar, { type Task } from '../components/Taskbar.astro';

interface Props {
  title: string;
  description: string;
  tasks: Task[];
  type?: 'website' | 'article';
  jsonLd?: object;
  prCount?: number;
  mainClass?: string;
}
const { title, description, tasks, type, jsonLd, prCount, mainClass } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#18283A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Andres Salamanca" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href={vt323} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexSans} as="font" type="font/woff2" crossorigin />
    <Seo title={title} description={description} type={type} jsonLd={jsonLd} />
  </head>
  <body>
    <div class="desktop">
      <DesktopIcons prCount={prCount} />
      <main class={mainClass}>
        <slot />
      </main>
    </div>
    <Taskbar tasks={tasks} />
  </body>
</html>
